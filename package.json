{
  "name": "aws-amplify-cljs-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/lab": "^5.0.0-alpha.177",
    "@mui/material": "^5.18.0",
    "@mui/styles": "^5.18.0",
    "@mui/system": "^5.18.0",
    "aws-amplify": "^6.16.2",
    "react": "^18.3.1",
    "react-div-100vh": "^0.7.0",
    "react-dom": "^18.3.1",
    "use-sync-external-store": "^1.2.0"
  },
  "scripts": {
    "update-email-templates": "nbb scripts/update_email_templates.cljs",
    "update": "ncu -u && rm -rf node_modules && rm yarn.lock && yarn",
    "nuke": "rm -rf dist .shadow-cljs node_modules yarn.lock target karma/js report.html",
    "clear": "rm -rf target karma/js report.html",
    "lint": "clj-kondo --lint ./ --dependencies --parallel --copy-configs",
    "pretty": "prettier --write '**/*.*'",
    "cljfmt": "clojure -Sdeps '{:deps {cljfmt {:mvn/version \"0.9.2\"}}}' -m cljfmt.main fix",
    "format": "yarn cljfmt && yarn pretty && yarn lint",
    "dev": "concurrently 'yarn watch' 'yarn webpack'",
    "watch": "shadow-cljs watch app karma-test",
    "ci": "NODE_ENV=production shadow-cljs release app && shadow-cljs compile karma-test && NODE_ENV=production webpack && karma start --single-run --reporters junit,dots",
    "karma": "karma start",
    "build": "NODE_ENV=production shadow-cljs release app",
    "build-verbose": "shadow-cljs release --verbose app",
    "report": "shadow-cljs run shadow.cljs.build-report app report.html",
    "debug-build": "shadow-cljs release app --debug",
    "dev-build": "shadow-cljs compile app",
    "shadow-cljs-server": "shadow-cljs server",
    "webpack": "webpack --watch",
    "cypress": "CYPRESS_CONFIG=$(aws secretsmanager get-secret-value --secret-id cypress/config --query SecretString --output text) cypress open",
    "cypress:run": "CYPRESS_CONFIG=$(aws secretsmanager get-secret-value --secret-id cypress/config --query SecretString --output text) cypress run  --headless --browser chrome"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@aws-amplify/cli": "^14.2.3",
    "@aws-sdk/client-cognito-identity-provider": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/client-ses": "^3.750.0",
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/cypress": "^10.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^13.0.1",
    "cypress": "^13.17.0",
    "gmail-tester": "^1.3.8",
    "html-beautifier-webpack-plugin": "^1.0.6",
    "html-webpack-plugin": "^5.6.6",
    "karma": "6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-cljs-test": "^0.1.0",
    "karma-junit-reporter": "^2.0.1",
    "nbb": "^1.2.174",
    "npm-check-updates": "^17.1.14",
    "prettier": "^3.8.1",
    "promise-poller": "^1.9.1",
    "react-test-renderer": "^18.3.1",
    "shadow-cljs": "^2.28.22",
    "start-server-and-test": "^2.0.0",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4"
  }
}
